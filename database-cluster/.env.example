# ===============================================================================
# PostgreSQL Database Cluster - Environment Variables
# ===============================================================================
# Copy file ini ke .env dan isi dengan nilai yang sesuai
# Command: cp .env.example .env

# ===============================================================================
# DATABASE AUTHENTICATION
# ===============================================================================
# PostgreSQL superuser credentials
POSTGRES_USER=dbadmin
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=postgres

# Replication user credentials (untuk master-slave sync)
REPLICATION_USER=replicator
REPLICATION_PASSWORD=changeme_replication_password_here

# ===============================================================================
# PORT MAPPINGS
# ===============================================================================
# Host ports untuk akses dari luar container
DB_MASTER_PORT=5432
DB_SLAVE1_PORT=5433
DB_SLAVE2_PORT=5434
PGADMIN_PORT=5050

# ===============================================================================
# PGADMIN CONFIGURATION
# ===============================================================================
PGADMIN_EMAIL=admin@localhost
PGADMIN_PASSWORD=changeme_pgadmin_password

# ===============================================================================
# POSTGRESQL PERFORMANCE TUNING
# ===============================================================================
# Adjust berdasarkan RAM server Anda
# Rule of thumb: shared_buffers = 25% of RAM, effective_cache = 50-75% of RAM

# Shared buffers (25% of RAM recommended)
SHARED_BUFFERS=256MB

# Effective cache size (50% of RAM recommended)
EFFECTIVE_CACHE_SIZE=1GB

# Work memory per query operation
WORK_MEM=16MB

# Maintenance work memory (for VACUUM, CREATE INDEX)
MAINTENANCE_WORK_MEM=128MB

# ===============================================================================
# BACKUP CONFIGURATION
# ===============================================================================
# Databases to backup (comma-separated, atau "all" untuk semua)
BACKUP_DATABASES=postgres

# Backup schedule (cron format)
# Examples:
#   @daily    = setiap hari jam 00:00
#   @weekly   = setiap minggu
#   0 3 * * * = setiap hari jam 03:00
BACKUP_SCHEDULE=@daily

# Backup retention (berapa lama backup disimpan)
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ===============================================================================
# SYSTEM SETTINGS
# ===============================================================================
# Timezone
TZ=Asia/Jakarta

# ===============================================================================
# DOCKER PROXY (OPTIONAL)
# ===============================================================================
# Uncomment jika butuh akses Docker socket dari container lain
# DOCKERPROXY_POST=1
