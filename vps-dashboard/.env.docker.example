# ============================================================================
# Docker Compose env file — copy ke .env lalu isi semua nilai.
# JANGAN commit .env ke git.
# ============================================================================

# ---- Cloudflare Tunnel ----
# Tunnel sekarang pakai credentials-file (bukan TUNNEL_TOKEN), supaya
# ingress rules diambil dari cloudflared-config/config.yml lokal — bukan
# dari Cloudflare dashboard remote (yang kosong → 503).
#
# Setup sekali (di host, bukan container):
#   1. cloudflared tunnel login                         # dapatkan cert.pem
#   2. cloudflared tunnel create <nama-tunnel>          # generate <UUID>.json
#   3. Copy <UUID>.json ke vps-dashboard/cloudflared-config/credentials.json
#   4. Edit cloudflared-config/config.yml: isi `tunnel: <UUID>` dan ingress hostname
#   5. cloudflared tunnel route dns <nama-tunnel> <hostname>   # buat DNS record
#
# File credentials.json di-gitignore. Tidak ada secret di .env untuk tunnel.

# ---- Auth & Bootstrap ----
# Generate secret kuat. Linux/WSL: `openssl rand -hex 64`
# PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
JWT_SECRET=

# JWT lifetime (Go duration). Saran: 2h-4h untuk dashboard pribadi.
JWT_TTL=2h

# Admin bootstrap — hanya dipakai sekali saat tabel users masih kosong.
# Setelah admin terbuat, ganti password dari UI lalu kosongkan baris ini.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Domain & CORS ----
# Origin yang diizinkan (frontend kamu lewat Cloudflare).
# Pisahkan dengan koma kalau lebih dari satu.
CORS_ORIGINS=https://server-dmr.devplay.online

# ---- Logging & Timezone ----
LOG_LEVEL=info
TZ=Asia/Jakarta

# ---- Retention & Cadence ----
EVENTS_RETENTION=720h
HEALTH_RETENTION=336h
HEALTHCHECK_INTERVAL=60s
SYSTEM_TICK_INTERVAL=30s

# ---- Backup ----
BACKUP_KEEP=7
BACKUP_HOUR_LOCAL=3

# ---- Docker Socket Proxy ----
# 0 = read-only (default, paling aman)
# 1 = izinkan POST (start/stop/restart container dari dashboard)
# Hanya set 1 kalau benar-benar butuh dan kamu paham risikonya.
DOCKERPROXY_POST=0

# ---- Disk usage source ----
# Path container yang dipakai backend untuk laporan disk usage. Default "/host"
# mengikuti bind-mount `/:/host:ro` di docker-compose.yml. Kalau bind-mount
# tersebut dihapus, backend otomatis fallback ke "/" (rootfs container).
# Set kosong/"/" kalau ingin laporan hanya untuk filesystem container.
SYSTEM_ROOT_PATH=/host

# ---- PM2 Hybrid Setup ----
# Path PM2 home directory di HOST (tempat daemon menulis pub.sock + rpc.sock).
# - WSL2 / Linux dengan PM2 jalan sebagai root  → /root/.pm2  (default)
# - PM2 jalan sebagai user non-root             → /home/<user>/.pm2
# Path INI hanya source bind-mount; target di container sudah fix di
# /home/app/.pm2 (PM2_HOME container sudah di-set di compose).
#
# CATATAN PERMISSION (penting untuk first run):
# Container API jalan sebagai user `app` (UID 1000). Kalau direktori PM2 home
# di host dimiliki user lain (mis. root UID 0 dengan mode 0700/0755), PM2
# client di container akan gagal dengan EACCES saat init file structure
# (mkdir logs/, pids/, modules/, write module_conf.json, dll).
#
# Fix paling clean tanpa ubah user container — share via group GID 1000:
#   sudo chgrp -R 1000 /root/.pm2
#   sudo chmod -R g+rwX /root/.pm2
#   sudo find /root/.pm2 -type d -exec chmod g+s {} \;   # inherit group utk file baru
#
# Kalau folder belum ada, buat dengan permission yang benar:
#   sudo mkdir -p /root/.pm2/{logs,pids,modules}
#   sudo chown -R root:1000 /root/.pm2
#   sudo chmod -R 2775 /root/.pm2
#
# CATATAN HYBRID DAEMON:
# Container akan spawn PM2 daemon-nya sendiri di mount ini saat first call
# (mis. GET /pm2/processes). Kalau host JUGA jalan PM2 daemon sebagai root
# di path yang sama, akan ada dua daemon menulis ke socket yang sama →
# konflik. Untuk hybrid mode bersih, jalankan PM2 di host sebagai user UID
# 1000 (bukan root), atau pakai PM2_HOME terpisah.
PM2_HOME=/root/.pm2
