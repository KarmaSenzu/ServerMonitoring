# VPS Dashboard Configuration
# Copy this file to .env and configure for your environment

# ==============================================================================
# REQUIRED CONFIGURATION
# ==============================================================================

# JWT Secret (REQUIRED) - Use a strong random string
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-min-32-chars-long-change-this

# ==============================================================================
# BASIC CONFIGURATION
# ==============================================================================

# Environment: development | production
ENV=production

# HTTP Server
HTTP_ADDR=:3001

# Database
DB_PATH=./data/vpsdash.db

# JWT Token Time-To-Live
JWT_TTL=24h

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# ==============================================================================
# FIRST-TIME SETUP
# ==============================================================================

# Bootstrap Admin User (only used on first boot when database is empty)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme123

# ==============================================================================
# DATA RETENTION & CLEANUP
# ==============================================================================

# How long to keep events in database
EVENTS_RETENTION=720h  # 30 days

# How long to keep health check results
HEALTH_RETENTION=336h  # 14 days

# How long to keep remote server metrics
REMOTE_RETENTION=24h

# ==============================================================================
# MONITORING INTERVALS
# ==============================================================================

# Health check probe interval
HEALTHCHECK_INTERVAL=60s

# System alert evaluation interval
SYSTEM_TICK_INTERVAL=30s

# Remote server metrics collection interval
REMOTE_POLL_INTERVAL=60s

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================

# Backup directory
BACKUP_DIR=./data/backups

# Number of backups to keep
BACKUP_KEEP=7

# Daily backup time (hour in 24h format, local time)
BACKUP_HOUR_LOCAL=3

# ==============================================================================
# SSH ENGINE CONFIGURATION
# ==============================================================================

# Directory where SSH private keys are stored
SSH_KEYS_DIR=./data/ssh-keys

# Maximum parallel SSH connections for remote monitoring
REMOTE_MAX_PARALLEL=4

# Timeout for SSH commands
REMOTE_COMMAND_TIMEOUT=15s

# ==============================================================================
# OPTIONAL: MCP/AI INTEGRATION (Phase 12)
# ==============================================================================

# Enable MCP server for AI agent access (leave empty to disable)
# MCP_API_KEY=your-api-key-here

# MCP audit log path (JSON Lines format)
# MCP_AUDIT_PATH=./data/mcp-audit.jsonl

# ==============================================================================
# OPTIONAL: SSH PASSWORD REFERENCES
# ==============================================================================

# If using password authentication, define passwords here
# Reference format: VPSD_SSH_PASSWORD_<REF>
# Example: If credential_ref="prod" in servers.yaml:
# VPSD_SSH_PASSWORD_PROD=your-ssh-password

# ==============================================================================
# DOCKER-SPECIFIC (when running in container)
# ==============================================================================

# Host filesystem mounts for metrics collection
# HOST_PROC=/host/proc
# HOST_SYS=/host/sys
# HOST_ETC=/host/etc
# SYSTEM_ROOT_PATH=/host

# Docker socket proxy address
# DOCKER_HOST=tcp://dockerproxy:2375

# PM2 daemon socket location
# PM2_HOME=/home/app/.pm2
