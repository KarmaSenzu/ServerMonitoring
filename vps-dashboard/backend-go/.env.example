# Application environment: development | production
ENV=development

# HTTP listen address (matches existing nginx-dashboard.conf upstream)
HTTP_ADDR=:3001

# SQLite database file path. Parent directory is auto-created.
DB_PATH=./data/vps-dashboard.db

# JWT signing secret. REQUIRED. Use a long random string in production.
# Example: openssl rand -hex 64
JWT_SECRET=

# JWT time-to-live (Go duration: 15m, 1h, 24h, 168h, ...)
JWT_TTL=24h

# Bootstrap admin credentials. Used ONLY on first run when the users table is empty.
# After the admin user exists, these are ignored.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# CORS allowed origins, comma-separated. Use the frontend dev/prod origins.
CORS_ORIGINS=http://localhost:5173

# How long events rows are retained before the maintenance purger
# deletes them. Go duration string (e.g. 720h = 30 days).
EVENTS_RETENTION=720h

# How long health_results rows are retained before the maintenance
# purger deletes them. Go duration string (e.g. 336h = 14 days).
HEALTH_RETENTION=336h

# Cadence of the project health-check engine.
HEALTHCHECK_INTERVAL=60s

# Cadence of the system metrics tick that feeds the alert evaluator.
SYSTEM_TICK_INTERVAL=30s

# Wave 4 backup knobs.
# Directory used to store SQLite backup snapshots. Auto-created on boot.
BACKUP_DIR=./data/backups
# How many successful backup snapshots to retain (oldest are pruned).
BACKUP_KEEP=7
# Hour of day (0..23, local time) at which the daily backup runs.
BACKUP_HOUR_LOCAL=3
