# Copy to deploy.env and fill in. NEVER commit deploy.env.
# Authentication: prefer SSH key. Set VPS_SSH_KEY for key auth.
# Set VPS_PASS only as a fallback for legacy sshpass/expect flows.

VPS_HOST=43.157.228.47
VPS_USER=ubuntu
VPS_HOSTNAME=server-dmr.devplay.online

# Path to private key for SSH key auth (recommended)
VPS_SSH_KEY=

# Optional fallback password for sshpass/expect. Leave empty to require key auth.
VPS_PASS=

# Local project directory used by deploy scripts
PROJECT_DIR="/Users/damarfikrie/Documents/Coding/PROJECT YANG DI TARUH DI LINUX/MONITORING SERVER/vps-dashboard"

# Remote paths
REMOTE_APP_DIR=/home/ubuntu/vps-dashboard
REMOTE_WEB_DIR=/var/www/vps-dashboard
